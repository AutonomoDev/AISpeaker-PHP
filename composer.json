{
    "name": "autonomo/ai-speaker",
    "version": "1.0.0",
    "description": "A quick and easy extension for effortlessly handling many LLM APIs",
    "keywords": [
        "chatgpt",
        "openai",
        "gpt",
        "gpt4",
        "api"
    ],
    "homepage": "https://www.autonomous.codes/",
    "license": "cc-by-nc-4.0",
    "authors": [
        {
            "name": "Autonomous Programming, LLC.",
            "homepage": "https://www.autonomous.codes/"
        },
        {
            "name": "Theodore R. Smith",
            "homepage": "https://www.linkedin.com/in/tedrsmith"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "phpexperts/rest-speaker": "*",
        "phpexperts/simple-dto": "*",
        "nstwf/extended-reflection-class": "^1.2"
    },
    "suggest": {
        "phpexperts/laravel-env-polyfill": "1.*"
    },
    "require-dev": {
        "phpunit/phpunit": "8.*|9.*",
        "phpstan/phpstan": "*",
        "symfony/var-dumper": "*",
        "phpexperts/laravel-env-polyfill": "*",
        "phpexperts/dockerize": "*",
        "octoper/cuzzle": "^3.1",
        "monolog/monolog": "^2.8"
    },
    "autoload": {
        "psr-4": { "Autonomo\\AiSpeaker\\" : "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Autonomo\\AiSpeaker\\Tests\\" : "tests/" }
    },
    "config": {
        "allow-plugins": {
            "0.0.0/composer-include-files": true
        }
    }
}
